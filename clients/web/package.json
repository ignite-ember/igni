{
  "name": "@ignite-ember/web-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Shared igni chat UI — the web client, and the UI the Tauri desktop app hosts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gen:visualizer-prompt": "tsx scripts/gen-visualizer-prompt.ts",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@json-render/core": "^0.21.3",
    "@json-render/react": "^0.21.3",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.17.2",
    "partial-json": "^0.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "react-virtuoso": "^4.18.20",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "ws": "^8.22.1"
  }
}
