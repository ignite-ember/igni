{
  "name": "@ignite-ember/ui-react",
  "version": "0.1.0",
  "description": "The React components an igni extension is allowed to build on. Everything exported here is under the compatibility floor.",
  "keywords": [
    "igni",
    "extension",
    "react",
    "components",
    "ui"
  ],
  "license": "Apache-2.0",
  "author": "Ignite Ember (https://ignite-ember.sh/)",
  "homepage": "https://github.com/ignite-ember/igni/tree/main/packages/ui-react#readme",
  "bugs": {
    "url": "https://github.com/ignite-ember/igni/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignite-ember/igni.git",
    "directory": "packages/ui-react"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-markdown": "^9.0.0 || ^10.0.0",
    "remark-gfm": "^4.0.0",
    "mermaid": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
